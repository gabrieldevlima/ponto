# Bibliotecas internas — nunca devem ser acessíveis via web.
#
# O .htaccess da raiz já reescreve tudo que não seja public/ ou api/ para dentro
# de public/, então lib/ não é servido hoje. Isso depende de mod_rewrite estar
# ativo: se ele for desabilitado ou a regra mudar, os arquivos ficariam expostos.
# Este bloqueio é a defesa que não depende dessa suposição.

<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order allow,deny
  Deny from all
</IfModule>

Options -Indexes
