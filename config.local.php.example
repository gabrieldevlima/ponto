/**
 * MODELO de config.local.php — copie para `config.local.php` e preencha.
 *
 * `config.local.php` está no .gitignore e NUNCA deve ser versionado.
 * `config.php`, ao contrário, É versionado — por isso nenhum segredo pode
 * ficar lá. Este arquivo é carregado por config.php antes dos define() de
 * banco e antes de helpers.php.
 *
 * Em produção, prefira variáveis de ambiente quando o provedor permitir; as
 * funções de segredo consultam a constante primeiro e o env em seguida.
 */

