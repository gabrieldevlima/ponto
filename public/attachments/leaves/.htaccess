# Bloqueia acesso HTTP direto a arquivos de atestados médicos.
# Todos os acessos devem passar por view_leave_attachment.php (autenticado).
# Apache 2.4+
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
# Apache 2.2 (fallback)
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
